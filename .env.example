# =============================================================================
# IWACU RWANDA — Environment Variables
# Copy to .env.local and fill in real values. Never commit real secrets.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Rate limiting (Upstash Redis) ------------------------------------------
# REQUIRED in production: sensitive routes (admin writes) fail
# CLOSED - refuse the request - in production if these are unset.
# In development, requests fall back to an in-memory limiter when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Header your host sets with the real client IP, checked before the
# platform defaults (x-vercel-forwarded-for, cf-connecting-ip, x-real-ip).
# Optional - only needed on hosts other than Vercel/Cloudflare.
TRUSTED_IP_HEADER=

# --- AI router (Groq function-calling only; zero PII is sent) --------------
# Optional - ai-router route returns a graceful "unavailable" response when unset.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- App ---------------------------------------------------------------------
# Used for CSRF / same-origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional, not yet wired into any route ---------------------------------
# Reserved for a future IP-based geolocation fallback. No code reads this yet.
IP_GEO_API_KEY=
