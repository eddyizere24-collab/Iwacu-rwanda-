{
  "name": "iwacu-rwanda",
  "version": "0.2.0",
  "private": true,
  "description": "IWACU RWANDA — Civic platform for discovering administrative location and local leaders in Rwanda using GPS with strict privacy (NCSA Law compliance).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "test:watch": "tsx --test --watch 'tests/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate": "echo 'Apply sql/migrations/*.sql in order (Supabase branch first, then production after backup). See DEPLOYMENT.md'",
    "db:test": "psql -v ON_ERROR_STOP=1 -f sql/tests/00_supabase_stub.sql -f sql/migrations/001_core_schema.sql -f sql/migrations/002_leaders_workflow.sql -f sql/tests/002_leaders_workflow.test.sql",
    "ingest:boundaries": "tsx scripts/ingest-boundaries.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@turf/turf": "^7.1.0",
    "clsx": "^2.1.1",
    "groq-sdk": "^0.9.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
